{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "isolatedModules": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true, "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
